---
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Submissão EroJam</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }

      body {
        background-color: #150924;
        color: #f3f4f6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      @keyframes moveBg {
        0% { background-position: 0 0; }
        100% { background-position: 600px 600px; }
      }

      .bg-animation {
        position: fixed;
        inset: 0;
        background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 100 100" fill="none" stroke="%2310b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.35"><path d="M28 32h44a16 16 0 0 1 16 16v8a16 16 0 0 1-26 12l-6-6H44l-6 6A16 16 0 0 1 12 56v-8a16 16 0 0 1 16-16z"/><line x1="28" y1="44" x2="28" y2="52"/><line x1="24" y1="48" x2="32" y2="48"/><circle cx="68" cy="46" r="1.8" fill="%2310b981"/><circle cx="74" cy="50" r="1.8" fill="%2310b981"/><circle cx="62" cy="50" r="1.8" fill="%2310b981"/><circle cx="68" cy="54" r="1.8" fill="%2310b981"/></svg>');
        background-size: 110px 110px;
        animation: moveBg 40s linear infinite;
        z-index: -2;
      }

      .bg-overlay {
        position: fixed;
        inset: 0;
        background: radial-gradient(circle at center, rgba(21, 9, 36, 0.65) 0%, rgba(21, 9, 36, 0.88) 100%);
        z-index: -1;
      }

      header {
        border-bottom: 1px solid rgba(16, 185, 129, 0.25);
        background-color: rgba(27, 12, 46, 0.9);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .header-container {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0 24px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo-area {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .logo-icon {
        width: 42px;
        height: 42px;
        background: linear-gradient(135deg, #ec4899, #10b981);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 1.1rem;
        color: white;
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4);
      }

      .logo-text {
        font-weight: 800;
        font-size: 1.25rem;
        background: linear-gradient(to right, #f472b6, #34d399);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      nav {
        display: flex;
        gap: 8px;
        align-items: center;
      }

      nav a {
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        color: #fbcfe8;
        transition: all 0.2s ease;
      }

      nav a:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.08);
      }

      nav a.active {
        background: linear-gradient(135deg, #ec4899, #10b981);
        color: #ffffff;
        font-weight: 700;
        box-shadow: 0 4px 16px rgba(236, 72, 153, 0.4);
        border: 1px solid rgba(252, 207, 232, 0.4);
      }

      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
      }

      .card {
        width: 100%;
        max-width: 540px;
        background-color: rgba(27, 12, 46, 0.92);
        border: 1px solid rgba(236, 72, 153, 0.4);
        border-radius: 20px;
        padding: 45px 40px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.9), 0 0 40px rgba(236, 72, 153, 0.2);
        backdrop-filter: blur(20px);
        text-align: center;
        position: relative;
      }

      h1 {
        font-size: 1.65rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 12px;
        line-height: 1.35;
      }

      .project-info {
        color: #fbcfe8;
        font-size: 0.92rem;
        margin-bottom: 32px;
      }

      .project-info span {
        color: #34d399;
        font-weight: 600;
      }

      .btn-primary {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, #ec4899, #10b981);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 1.05rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 10px 24px -5px rgba(236, 72, 153, 0.45);
      }

      .btn-primary:hover {
        opacity: 0.95;
        transform: translateY(-2px);
        box-shadow: 0 15px 30px -5px rgba(16, 185, 129, 0.6);
      }

      .hidden {
        display: none !important;
      }

      .loading-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        padding: 10px 0;
      }

      .loading-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: white;
      }

      .progress-track {
        width: 100%;
        background-color: rgba(15, 5, 25, 0.85);
        height: 14px;
        border-radius: 999px;
        overflow: hidden;
        border: 1px solid rgba(236, 72, 153, 0.4);
        padding: 2px;
      }

      .progress-fill {
        background: linear-gradient(90deg, #ec4899, #10b981);
        height: 100%;
        width: 0%;
        border-radius: 999px;
        transition: width 0.1s linear;
      }

      .status-text {
        color: #34d399;
        font-family: monospace;
        font-size: 0.95rem;
        height: 24px;
      }

      .success-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 10px 0;
      }

      .success-icon {
        width: 72px;
        height: 72px;
        background: rgba(16, 185, 129, 0.2);
        border: 1px solid rgba(16, 185, 129, 0.5);
        color: #34d399;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        animation: pulseGlow 1.2s infinite alternate;
      }

      @keyframes pulseGlow {
        from { transform: scale(1); box-shadow: 0 0 10px rgba(16, 185, 129, 0.3); }
        to { transform: scale(1.08); box-shadow: 0 0 25px rgba(16, 185, 129, 0.7); }
      }

      .success-title {
        font-size: 1.8rem;
        font-weight: 800;
        color: white;
      }

      .success-subtitle {
        color: #34d399;
        font-weight: 700;
        font-size: 1.15rem;
      }

      .success-desc {
        color: #fbcfe8;
        font-size: 0.88rem;
        line-height: 1.5;
      }

      footer {
        border-top: 1px solid rgba(16, 185, 129, 0.25);
        background-color: rgba(27, 12, 46, 0.9);
        backdrop-filter: blur(12px);
        padding: 24px;
        text-align: center;
        color: #fbcfe8;
        font-size: 0.85rem;
        position: relative;
        z-index: 50;
      }
    </style>
  </head>

  <body>
    <div class="bg-animation"></div>
    <div class="bg-overlay"></div>

    <header>
      <div class="header-container">
        <div class="logo-area">
          <div class="logo-icon">EJ</div>
          <span class="logo-text">EroJam</span>
        </div>

        <nav>
          <a href="#">Início</a>
          <a href="#">Sobre Nós</a>
          <a href="#" class="active">EroJam</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="card">
        <div id="step-confirm">
          <h1>Deseja confirmar sua submissão da EroJam?</h1>
          <p class="project-info">
            Arquivo selecionado: <span>Jogo_Ex.zip</span> (142 MB)
          </p>
          <button id="btn-submit" class="btn-primary">
            Confirmar e Enviar Jogo
          </button>
        </div>

        <div id="step-loading" class="hidden loading-container">
          <h2 class="loading-title">Enviando submissão...</h2>
          <div class="progress-track">
            <div id="progress-bar" class="progress-fill"></div>
          </div>
          <p id="status-text" class="status-text">Conectando ao servidor...</p>
        </div>

        <div id="step-success" class="hidden success-container">
          <div class="success-icon">✓</div>
          <h2 class="success-title">Parabéns!</h2>
          <p class="success-subtitle">Você enviou seu jogo para a EroJam!</p>
          <p class="success-desc">
            Sua build foi enviada e registrada com sucesso. Agora seu jogo está oficialmente participando do evento!
          </p>
        </div>
      </div>
    </main>

    <footer>
      &copy; 2026 EroJam Platform. Todos os direitos reservados.
    </footer>

    <script>
      const btnSubmit = document.getElementById('btn-submit');
      const stepConfirm = document.getElementById('step-confirm');
      const stepLoading = document.getElementById('step-loading');
      const stepSuccess = document.getElementById('step-success');
      const progressBar = document.getElementById('progress-bar');
      const statusText = document.getElementById('status-text');

      const messages = [
        "Iniciando transferência de dados...",
        "Enviando seus arquivos (.zip)...",
        "Verificando integridade da build...",
        "Finalizando submissão...",
        "Registrando jogo na plataforma..."
      ];

      btnSubmit?.addEventListener('click', () => {
        stepConfirm.classList.add('hidden');
        stepLoading.classList.remove('hidden');

        let progress = 0;
        let messageIndex = 0;

        const interval = setInterval(() => {
          progress += 2;
          if (progressBar) progressBar.style.width = `${progress}%`;

          if (progress % 20 === 0 && messageIndex < messages.length - 1) {
            messageIndex++;
            if (statusText) statusText.textContent = messages[messageIndex];
          }

          if (progress >= 100) {
            clearInterval(interval);
            setTimeout(() => {
              stepLoading.classList.add('hidden');
              stepSuccess.classList.remove('hidden');
            }, 400);
          }
        }, 60);
      });
    </script>
  </body>
</html>